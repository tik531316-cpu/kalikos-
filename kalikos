<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalikos_Tv - المركز الرسمي</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif, Tahoma;
        }
        body {
            background-color: #0d0f17;
            color: #ffffff;
            padding: 15px;
            direction: rtl;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #16192b;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid #252a48;
        }
        .logo-title {
            font-size: 1.4rem;
            font-weight: bold;
            color: #00ff88;
        }
        .lock-btn {
            background: #ff4757;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: bold;
        }

        /* العداد الإجمالي في الأعلى */
        .total-counter-box {
            background: linear-gradient(135deg, #16192b, #1f2440);
            border: 2px solid #00ff88;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            margin-bottom: 25px;
            box-shadow: 0 6px 15px rgba(0, 255, 136, 0.15);
        }
        .total-counter-box h3 {
            font-size: 1.1rem;
            color: #00ff88;
            margin-bottom: 8px;
        }
        .total-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #ffffff;
            letter-spacing: 1px;
        }

        /* شبكة التطبيقات والعدادات الفردية */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }
        .social-card {
            background: #16192b;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #252a48;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        .social-card h3 {
            font-size: 1.1rem;
            margin-bottom: 8px;
        }
        .sub-counter {
            font-size: 1.5rem;
            font-weight: bold;
            color: #00ff88;
            margin: 10px 0;
        }
        .btn-social {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 16px;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 0.85rem;
        }
        .youtube-bg { background: #ff0000; }
        .tiktok-bg { background: #000000; border: 1px solid #333; }
        .insta-bg { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #df3497 45%, #7659c7 90%); }
        
        /* قسم فري فاير */
        .ff-section {
            background: #16192b;
            border: 1px solid #ffa502;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            text-align: center;
        }
        .ff-title {
            color: #ffa502;
            font-size: 1.2rem;
            margin-bottom: 10px;
            font-weight: bold;
        }
        .id-box {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }
        .id-number {
            background: #0d0f17;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #00ff88;
            letter-spacing: 2px;
            border: 1px solid #252a48;
        }
        .btn-copy {
            background: #ffa502;
            color: #0d0f17;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-copy:hover {
            background: #eccc68;
        }

        .main-content {
            background: #16192b;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #252a48;
            text-align: center;
        }
        .main-content h2 {
            color: #ffa502;
            margin-bottom: 10px;
            font-size: 1.2rem;
        }

        /* نافذة كلمة السر */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }
        .modal-box {
            background: #16192b;
            padding: 25px;
            border-radius: 12px;
            width: 90%;
            max-width: 380px;
            text-align: center;
            border: 1px solid #00ff88;
        }
        .modal-box input {
            width: 100%;
            padding: 12px;
            margin: 15px 0;
            background: #0d0f17;
            border: 1px solid #252a48;
            color: #fff;
            border-radius: 8px;
            text-align: center;
            font-size: 1rem;
        }
        .modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
        }
        .modal-buttons button {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-enter { background: #00ff88; color: #0d0f17; }
        .btn-close { background: #ff4757; color: #fff; }
    </style>
</head>
<body>

    <!-- الهيدر واللوغو -->
    <header>
        <div class="logo-title">Kalikos_Tv Hub</div>
        <button class="lock-btn" onclick="showAdminModal()">🔒 قفل المشرف</button>
    </header>

    <!-- العداد الإجمالي المشترك في الأعلى -->
    <div class="total-counter-box">
        <h3>🌟 إجمالي جمهور ومتابعي المنصة</h3>
        <div id="totalGlobalCounter" class="total-number">34820</div>
    </div>

    <!-- قسم فري فاير (Free Fire ID) -->
    <div class="ff-section">
        <div class="ff-title">🎮 Free Fire Player ID</div>
        <p style="color: #8b92b7; font-size: 0.9rem;">الـ ID الخاص بي في لعبة فري فاير (اضغط لنسخ الرقم)</p>
        <div class="id-box">
            <div class="id-number" id="ffId">6751991810</div>
            <button class="btn-copy" onclick="copyFFId()">📋 نسخ الـ ID</button>
        </div>
    </div>

    <!-- بطاقات منصات التواصل مع عداد مستقل لكل تطبيق -->
    <div class="social-grid">
        <!-- يوتيوب -->
        <div class="social-card">
            <h3 style="color: #ff0000;">YouTube</h3>
            <div id="youtubeCounter" class="sub-counter">14250</div>
            <p style="color: #8b92b7; font-size: 0.85rem;">مستخدماً لقطات وفيديوهات فري فاير</p>
            <a href="https://youtube.com/@kalikos_tv?si=0698c-96KckNrvQQ" class="btn-social youtube-bg" target="_blank">زيارة القناة</a>
        </div>

        <!-- تيك توك -->
        <div class="social-card">
            <h3 style="color: #ffffff;">TikTok</h3>
            <div id="tiktokCounter" class="sub-counter">15400</div>
            <p style="color: #8b92b7; font-size: 0.85rem;">مقاطع قصيرة ولقطات حماسية</p>
            <a href="https://www.tiktok.com/@kalikos._tv?_r=1&_t=ZS-9AX7dl5a6MO" class="btn-social tiktok-bg" target="_blank">تابعني على تيك توك</a>
        </div>

        <!-- إنستغرام -->
        <div class="social-card">
            <h3 style="color: #fd1d1d;">Instagram</h3>
            <div id="instaCounter" class="sub-counter">5170</div>
            <p style="color: #8b92b7; font-size: 0.85rem;">القصص والتحديثات اليومية</p>
            <a href="https://instagram.com/kalikos_tv?xtok=N3RvNW52cWF3MTMz" class="btn-social insta-bg" target="_blank">تابعني على إنستغرام</a>
        </div>
    </div>

    <!-- المحتوى والاقسام -->
    <div class="main-content">
        <h2>أهلاً بك في منصة Kalikos_Tv الرسمية</h2>
        <p>المركز المخصص لمتابعة المحتوى والتحديثات الحصرية.</p>
    </div>

    <!-- نافذة إدخال الباسورد -->
    <div id="adminModal" class="modal-overlay">
        <div class="modal-box">
            <h3 style="color: #00ff88;">لوحة المشرف</h3>
            <p style="font-size: 0.85rem; color: #8b92b7; margin-top: 5px;">أدخل كلمة السر للوصول للوحة التحكم</p>
            <input type="password" id="passInput" placeholder="كلمة السر...">
            <div class="modal-buttons">
                <button class="btn-enter" onclick="checkPassword()">دخول</button>
                <button class="btn-close" onclick="hideAdminModal()">إلغاء</button>
            </div>
        </div>
    </div>

    <script>
        // حركة العدادات الذكية المتصلة (الفردية والإجمالية)
        setInterval(function() {
            var yt = document.getElementById('youtubeCounter');
            var tk = document.getElementById('tiktokCounter');
            var ig = document.getElementById('instaCounter');
            var total = document.getElementById('totalGlobalCounter');

            if (yt && tk && ig && total) {
                // زيادة عشوائية بسيطة لكل منصة
                var ytVal = parseInt(yt.innerText) + (Math.random() > 0.6 ? 1 : 0);
                var tkVal = parseInt(tk.innerText) + (Math.random() > 0.5 ? 1 : 0);
                var igVal = parseInt(ig.innerText) + (Math.random() > 0.8 ? 1 : 0);

                yt.innerText = ytVal;
                tk.innerText = tkVal;
                ig.innerText = igVal;

                // المجموع الكلي يتحدث تلقائياً بناءً على مجموعهم
                total.innerText = ytVal + tkVal + igVal;
            }
        }, 2000);

        // دالة نسخ ايدي فري فاير
        function copyFFId() {
            var idText = document.getElementById('ffId').innerText;
            navigator.clipboard.writeText(idText).then(function() {
                alert("تم نسخ الـ ID بنجاح: " + idText);
            }, function() {
                alert("تعذر النسخ تلقائياً، يرجى تحديده ونسخه يدوياً.");
            });
        }

        // دوال زر القفل وكلمة السر
        function showAdminModal() {
            document.getElementById('adminModal').style.display = 'flex';
            document.getElementById('passInput').value = '';
        }

        function hideAdminModal() {
            document.getElementById('adminModal').style.display = 'none';
        }

        function checkPassword() {
            var pass = document.getElementById('passInput').value;
            if (pass === "admin2008") {
                alert("تم التحقق بنجاح! مرحباً بك يا مدير في لوحة تحكم Kalikos_Tv.");
                hideAdminModal();
            } else {
                alert("كلمة السر خاطئة!");
            }
        }
    </script>

</body>
</html>
